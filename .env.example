# Copy to .env (never commit .env). These are local-development placeholders, not real secrets.
# Docker Compose reads .env automatically. Spring Boot and the scripts do not: the application
# falls back to the same defaults, so export a variable only if you change its value here.

# PostgreSQL (container and application)
POSTGRES_DB=docresearch
POSTGRES_USER=docresearch
POSTGRES_PASSWORD=local_dev_only_change_me
# Host and port the application connects to
POSTGRES_HOST=localhost
# Host port published on 127.0.0.1 by Compose
POSTGRES_PORT=5432

# Ollama
# Host port published on 127.0.0.1 by Compose
OLLAMA_PORT=11434
# Where the application and scripts reach Ollama. For Ollama installed on the host instead of
# Compose, keep the default http://localhost:11434 and do not start the compose "ollama" service
# (see ADR-004).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
